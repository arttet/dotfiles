# Zsh history, navigation and interactive defaults.

export HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
export HISTSIZE=10000
export SAVEHIST=20000

setopt APPEND_HISTORY EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE HIST_VERIFY SHARE_HISTORY
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt LONG_LIST_JOBS NOTIFY NO_BEEP
setopt GLOB_DOTS EXTENDED_GLOB NO_CASE_GLOB

alias history='fc -li 1'

{
  "mcpServers": {
    "context7": {
      "command": "context7-mcp",
      "args": [],
      "startupTimeoutMs": 60000,
      "toolTimeoutMs": 120000
    },
    "playwright": {
      "command": "playwright-mcp",
      "args": [],
      "startupTimeoutMs": 60000,
      "toolTimeoutMs": 120000
    },
    "serena": {
      "command": "serena-agent",
      "args": [
        "start-mcp-server",
        "--context=agent",
        "--project-from-cwd",
        "--open-web-dashboard=false"
      ],
      "startupTimeoutMs": 60000,
      "toolTimeoutMs": 120000
    },
    "graphify": {
      "command": "graphify-mcp",
      "args": ["graphify-out/graph.json"],
      "startupTimeoutMs": 60000,
      "toolTimeoutMs": 120000
    },
    "vikunja": {
      "enabled": false,
      "command": "vikunja-mcp",
      "args": [],
      "env": {
        "VIKUNJA_URL": "${VIKUNJA_URL}",
        "VIKUNJA_API_TOKEN": "${VIKUNJA_API_TOKEN}"
      },
      "startupTimeoutMs": 60000,
      "toolTimeoutMs": 120000
    }
  }
}

# Bash login environment.

# Windows (MSYS/Git Bash/Cygwin) - normalize HOME path
case "$OSTYPE" in
msys* | cygwin*)
  case "$HOME" in
  [A-Za-z]:[\\/]*) export HOME="$(cygpath -u "$HOME")" ;;
  esac
  ;;
esac

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

_dotfiles_shell_dir="${XDG_CONFIG_HOME}/shell/profile.d"
if [[ -d "$_dotfiles_shell_dir" ]]; then
  for _dotfiles_file in "$_dotfiles_shell_dir"/*.sh; do
    [[ -r "$_dotfiles_file" ]] && source "$_dotfiles_file"
  done
fi
unset _dotfiles_shell_dir _dotfiles_file

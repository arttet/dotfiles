# Bash interactive configuration.

# Exit early if not running interactively
[[ $- != *i* ]] && return

_dotfiles_shell_dir="${XDG_CONFIG_HOME:-$HOME/.config}/shell/shell.d"
if [[ -d "$_dotfiles_shell_dir" ]]; then
  for _dotfiles_file in "$_dotfiles_shell_dir"/*.sh; do
    [[ -r "$_dotfiles_file" ]] && source "$_dotfiles_file"
  done
fi

_dotfiles_bash_dir="${XDG_CONFIG_HOME:-$HOME/.config}/bash/bash.d"
if [[ -d "$_dotfiles_bash_dir" ]]; then
  for _dotfiles_file in "$_dotfiles_bash_dir"/*.bash; do
    [[ -r "$_dotfiles_file" ]] && source "$_dotfiles_file"
  done
fi
unset _dotfiles_shell_dir _dotfiles_bash_dir _dotfiles_file

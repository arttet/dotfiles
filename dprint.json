{
  "lineWidth": 120,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "markdown": {
    "textWrap": "maintain"
  },
  "excludes": [
    "**/*-lock.json",
    "**/lazy-lock.json",
    "**/node_modules",
    ".dotter",
    ".github/workflows/ci.yml",
    ".serena",
    ".tools",
    "docs/.vitepress/cache",
    "docs/aube-lock.yaml",
    "docs/dist",
    "dotfiles/.config/alacritty/themes",
    "dotfiles/.config/tmux/plugins",
    "dotfiles/.config/yazi/flavors",
    "dotfiles/.config/yazi/plugins",
    "dotfiles/.local/share/backgrounds",
    "vendir.lock*.yml"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.21.3.wasm",
    "https://plugins.dprint.dev/markdown-0.22.1.wasm",
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ]
}

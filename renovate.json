{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": false,
  "enabledManagers": ["custom.regex", "github-actions", "mise", "npm", "vendir"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the mise CLI pinned in workflows; the mise manager only reads tool configs",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["MISE_VERSION:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases"
    }
  ],
  "ignorePaths": [
    ".serena/**",
    ".tools/**",
    "docs/.vitepress/cache/**",
    "docs/dist/**",
    "docs/node_modules/**",
    "out/**",
    "target/**"
  ],
  "labels": ["dependencies"],
  "vendir": {
    "managerFilePatterns": ["/(^|/)vendir\\.yml$/", "/(^|/)vendir\\.wallpapers\\.yml$/"]
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "groupName": "mise tools",
      "matchManagers": ["mise"]
    },
    {
      "description": "Bump the mise CLI together with the tools so CI can read the lockfile format it writes",
      "groupName": "mise tools",
      "matchDepNames": ["jdx/mise"]
    },
    {
      "groupName": "docs dependencies",
      "matchFileNames": ["docs/package.json"],
      "matchManagers": ["npm"]
    },
    {
      "groupName": "vendir sources",
      "matchManagers": ["vendir"]
    },
    {
      "description": "Treat vendir GitSource refs as exact refs, not SemVer versions",
      "matchManagers": ["vendir"],
      "matchDatasources": ["git-refs"],
      "versioning": "exact"
    }
  ],
  "rangeStrategy": "bump"
}

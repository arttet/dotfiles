{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": false,
  "enabledManagers": ["github-actions", "mise", "npm", "vendir"],
  "ignorePaths": [
    ".serena/**",
    ".tools/**",
    "docs/.vitepress/cache/**",
    "docs/dist/**",
    "docs/node_modules/**",
    "out/**",
    "target/**"
  ],
  "labels": ["dependencies"],
  "vendir": {
    "managerFilePatterns": ["/(^|/)vendir\\.yml$/", "/(^|/)vendir\\.wallpapers\\.yml$/"]
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "groupName": "mise tools",
      "matchManagers": ["mise"]
    },
    {
      "groupName": "docs dependencies",
      "matchFileNames": ["docs/package.json"],
      "matchManagers": ["npm"]
    },
    {
      "groupName": "vendir sources",
      "matchManagers": ["vendir"]
    },
    {
      "description": "Treat vendir GitSource refs as exact refs, not SemVer versions",
      "matchManagers": ["vendir"],
      "matchDatasources": ["git-refs"],
      "versioning": "exact"
    }
  ],
  "rangeStrategy": "bump"
}
